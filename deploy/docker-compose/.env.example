# Charmr Production Environment
# Copy this file to .env and update the values before starting.

# REQUIRED: Admin account password (created on first start)
CHARMR_ADMIN_PASSWORD=changeme

# Django secret key — generate a unique value for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF
# Include the full origin (scheme + host + port) of your frontend
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Container image tag to use (default: latest)
CHARMR_IMAGE_TAG=latest

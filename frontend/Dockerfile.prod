FROM registry.access.redhat.com/ubi9/nodejs-22 AS build

USER 0
WORKDIR /opt/app-root/src

COPY package.json package-lock.json* ./
RUN chown -R 1001:0 /opt/app-root/src
USER 1001

RUN npm install

COPY --chown=1001:0 . .

RUN npm run build

FROM registry.access.redhat.com/ubi9/ubi-minimal AS runtime

RUN microdnf install -y nginx && microdnf clean all

COPY --from=build /opt/app-root/src/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf

RUN chown -R 1001:0 /var/log/nginx /var/lib/nginx /run && \
    chmod -R g+w /var/log/nginx /var/lib/nginx /run

USER 1001

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
